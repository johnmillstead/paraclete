---
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const staff = await getCollection('staff');
  return staff.map((member) => {
    const slug = member.id.replace(/^.*\//, '').replace(/\.md$/, '');
    return { params: { slug }, props: { member } };
  });
}

const { member } = Astro.props;
const { name, title, photo } = member.data;
---
<BaseLayout pageTitle={name}>

<article class="staff-profile ml-4 mt-8 max-w-2xl">
  <img class="w-50 h-auto mt-6" src={photo} alt={`Photo of ${name}`} />
  <h1 class="font-bold mt-2">{name}</h1>
  <h2 class="italic">{title}</h2>

  <div class="bio text-2xl font-serif text-gray-700 mt-4 [&>p]:mb-4" set:html={member.rendered?.html} />
</article>
</BaseLayout>