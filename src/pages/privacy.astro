---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Privacy Policy";       
---

<BaseLayout pageTitle={pageTitle}>
  <span slot="title">Privacy Policy</span>

  <main class="max-w-4xl mx-auto px-6 py-12 text-gray-800">

    <!-- Main Title -->
    <h2 class="text-3xl md:text-4xl font-semibold text-testred mb-4">
      Privacy Policy
    </h2>

    <p class="mb-6">
      <strong>Paraclete Mission Group (PMG)</strong>
    </p>

    <p class="mb-6">
      Paraclete Mission Group is committed to respecting and protecting the privacy of all individuals who interact with our ministry—including donors, website visitors, event participants, and partners.
    </p>

    <p class="mb-10">
      This Privacy Policy explains how we collect, use, and safeguard your information.
    </p>

    <!-- Information We Collect -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Information We Collect
    </h3>

    <h4 class="text-lg font-semibold mt-4 mb-2">
      Personal Information You Provide
    </h4>
    <ul class="list-disc pl-6 space-y-2 mb-6">
      <li>Name, organization/church, address, phone number, email address</li>
      <li>Donation details and ministry preferences</li>
      <li>Communication preferences</li>
      <li>Information shared through forms, emails, or event participation</li>
    </ul>

    <h4 class="text-lg font-semibold mt-4 mb-2">
      Financial Information
    </h4>
    <ul class="list-disc pl-6 space-y-2 mb-6">
      <li>Payment details are processed through secure third-party providers</li>
      <li>Credit card or bank information is not stored on PMG systems</li>
    </ul>

    <h4 class="text-lg font-semibold mt-4 mb-2">
      Website & Technical Information
    </h4>
    <p class="mb-10">
      When you visit our website, we may collect limited technical data such as IP address, browser type, device information, and general usage patterns to improve our website and services.
    </p>

    <!-- Events -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Events, Meetings, and Recordings
    </h3>
    <p class="mb-4">
      PMG may record or live stream certain events, retreats, or online sessions.
    </p>
    <p class="mb-10">
      These recordings may include audio, video, shared content, or participant contributions. Recordings may be used for internal training, participant sharing, and ministry communications.
    </p>

    <!-- Use -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      How We Use Your Information
    </h3>
    <ul class="list-disc pl-6 space-y-2 mb-10">
      <li>Process donations and provide receipts</li>
      <li>Communicate ministry updates and newsletters</li>
      <li>Respond to inquiries and support requests</li>
      <li>Improve website and communications</li>
      <li>Support PMG ministry purposes</li>
    </ul>

    <!-- Protection -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      How We Protect Your Information
    </h3>
    <ul class="list-disc pl-6 space-y-2 mb-10">
      <li>Encryption for online transactions</li>
      <li>Access controls and secure systems</li>
      <li>Trusted third-party payment processors</li>
    </ul>

    <!-- Sharing -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Sharing of Information
    </h3>
    <p class="mb-4">
      Paraclete Mission Group does not sell, rent, trade, or lease personal information.
    </p>
    <p class="mb-10">
      We may share information only with trusted service providers or when required by law.
    </p>

    <!-- Cookies -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Cookies & Website Tracking
    </h3>
    <p class="mb-10">
      Our website may use basic cookies or analytics tools to understand usage and improve user experience.
    </p>

    <!-- Rights -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Your Rights
    </h3>
    <ul class="list-disc pl-6 space-y-2 mb-10">
      <li>Request access to your personal data</li>
      <li>Correct or update your information</li>
      <li>Request deletion of your data</li>
      <li>Opt out of communications</li>
      <li>Withdraw consent at any time</li>
    </ul>

    <!-- Communication -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Communication Preferences
    </h3>
    <p class="mb-10">
      You may opt out of communications, update preferences, or request removal from mailing lists at any time.
    </p>

    <!-- Children -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Children’s Privacy
    </h3>
    <p class="mb-10">
      PMG does not knowingly collect personal information from children under 13 without parental consent.
    </p>

    <!-- Retention -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Data Retention
    </h3>
    <p class="mb-10">
      We retain personal information only as long as necessary for ministry, administrative, and legal purposes.
    </p>

    <!-- Contact -->
    <h3 class="text-2xl font-semibold mt-10 mb-4">
      Contact Us
    </h3>
    <p>
      Paraclete Mission Group<br />
      Email: <a href="mailto:info@paraclete.net" class="text-blue-600 underline">info@paraclete.net</a><br />
      Phone: (719) 302-2500
    </p>

  </main>
</BaseLayout>
``