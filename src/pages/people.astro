---
import { getCollection } from 'astro:content';
import Layout from '../layouts/MinistryLayout.astro';
import StaffCard from '../components/StaffCard.astro';

const allStaff = await getCollection('staff', ({ data }) => {
  return data.active === true && data.draft === false;
});

const staff = allStaff.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const pageTitle = "People";
---

<Layout pageTitle={pageTitle}>
  <main class="people-page">

    
<section class="people-section mt-24">
  <h2 class="mt-8 text-2xl font-bold">Staff</h2>

  <div class="staff-grid mt-6">
    
{staff.map((member) => {
  const slug = member.id.replace(/^.*\//, '').replace(/\.md$/, '');

  return (
    <a href={`/staff/${slug}`} class="staff-card-link">
      <StaffCard
        name={member.data.name}
        title={member.data.title}
        photo={member.data.photo}
      />
    </a>
  );
})}

  </div>
</section>


 
    
  </main>
</Layout>

<style>

  .staff-card-link {
  text-decoration: none;
  color: inherit;
}

.staff-card-link:hover,
.staff-card-link:focus {
  transform: translateY(-2px);
}

</style>