---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle} transparentHeader={true}>

  <!-- HERO -->
  <section class="relative h-[75vh] overflow-hidden">

    <img
      src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/largegroup_hero1.jpg"
      alt="Paraclete Mission Group"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-black/35"></div>

    <!-- Hero Content -->
    <div class="relative z-10 flex h-full items-center">
      <div class="mx-auto w-full max-w-7xl px-6">

        <div class="max-w-3xl md:pl-20">
          <h1 class="text-5xl font-bold leading-tight text-white md:text-6xl">
            <span class="block">
              Coming
              <span class="text-emerald-500">alongside</span>
            </span>

            <span class="block md:pl-12">
              Christian leaders
            </span>
          </h1>
        </div>

      </div>
    </div>

    <!-- Smooth Transition -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-stone-50"></div>

  </section>

  <!-- INTRO SECTION -->
  <section class="bg-stone-50 py-24">

    <div class="mx-auto max-w-7xl px-6">

      <!-- Greek Definition -->
      <div class="mx-auto mb-20 max-w-5xl text-center">

        <p class="font-serif text-3xl italic text-emerald-800 md:text-5xl">
          paráklētos
        </p>

        <p class="mt-6 font-serif text-xl italic leading-relaxed text-slate-700 md:text-3xl">
          one who consoles or comforts, one who encourages or uplifts;
          hence refreshes, and/or one who intercedes on our behalf as an advocate.
        </p>

      </div>

      <!-- Lead Statement -->
      <div class="mx-auto mb-20 max-w-4xl text-center">

        <h2 class="font-serif text-3xl leading-tight text-slate-800 md:text-5xl">
          Coming alongside Christian leaders around the world.
        </h2>

      </div>

      <!-- Main Content -->
      <div class="grid gap-12 lg:grid-cols-[360px_1fr]">

        <!-- CEO CARD -->
        <aside class="rounded-2xl bg-white p-6 shadow-lg">

          <img
            src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/ceo_tim_bedford.jpg"
            alt="Tim Bedford"
            class="w-full rounded-xl object-cover"
          />

          <h3 class="mt-5 text-center text-2xl font-semibold text-slate-800">
            Tim Bedford
          </h3>

          <p class="text-center text-sky-700">
            President & CEO
          </p>

          <div class="mt-6 border-t border-slate-200 pt-6">

            <p class="text-slate-600 italic leading-relaxed">
              "Helping Christian leaders thrive personally,
              organizationally, and strategically through
              experienced mission practitioners."
            </p>

          </div>

          <!-- Optional credibility stats -->
          <div class="mt-6 border-t border-slate-200 pt-6">

            <div class="grid grid-cols-1 gap-3 text-center">

              <div>
                <div class="text-2xl font-bold text-emerald-700">
                  40+
                </div>
                <div class="text-sm text-slate-600">
                  Years Serving Global Missions
                </div>
              </div>

              <div>
                <div class="text-2xl font-bold text-emerald-700">
                  Worldwide
                </div>
                <div class="text-sm text-slate-600">
                  Ministry Partnerships
                </div>
              </div>

            </div>

          </div>

        </aside>

        <!-- TEXT COLUMN -->
        <div class="max-w-4xl">

          <p class="text-xl leading-relaxed text-slate-800 md:text-2xl">

            Paraclete Mission Group comes alongside mission agencies,
            churches, and church planting movements serving around
            the world.

            <span class="font-semibold text-amber-700">
              Paraclete associates
            </span>

            are experienced missionaries and professionals who
            use their histories, skills, and gifts to partner with
            individuals and organizations to help them become more
            effective in life and ministry.

          </p>

          <p class="mt-8 text-lg leading-relaxed text-slate-700 md:text-xl">

            Whether providing coaching, leadership development,
            member care, organizational consulting, or strategic
            guidance, Paraclete associates draw upon decades of
            cross-cultural ministry experience to strengthen leaders
            and organizations for long-term Kingdom impact.

          </p>

          <!-- CTA -->
          <div