---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle} transparentHeader={true}>

  <!-- HERO -->
  <section class="relative h-[75vh] overflow-hidden">

    <img
      src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/largegroup_hero1.jpg"
      alt="Paraclete Mission Group"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/35"></div>

    <!-- Hero Content -->
    <div class="relative z-10 flex h-full items-center">
      <div class="mx-auto w-full max-w-7xl px-6">

        <div class="max-w-3xl md:pl-20">

          <h1 class="text-5xl font-bold leading-tight text-white md:text-6xl">
            <span class="block">
              Coming
              <span class="text-emerald-500">alongside</span>
            </span>

            <span class="block md:pl-12">
              Christian leaders
            </span>
          </h1>

        </div>

      </div>
    </div>

    <!-- Hero → About Transition -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-b from-transparent to-stone-50"></div>

  </section>

  <!-- ABOUT SECTION -->
  <section class="bg-stone-50 py-20">

    <div class="mx-auto max-w-7xl px-6">

      <!-- Definition -->
      <div class="mb-14">

        <p class="font-serif text-2xl italic leading-relaxed text-emerald-800 md:text-4xl">
          paráklētos – one who consoles or comforts, one who encourages or uplifts;
          hence refreshes, and/or one who intercedes on our behalf as an advocate.
        </p>

      </div>

      <!-- Main Content -->
      <div class="grid items-start gap-10 lg:grid-cols-[280px_1fr]">

        <!-- CEO -->
        <div class="text-center">

          <img
            src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/ceo_tim_bedford.jpg"
            alt="Tim Bedford"
            class="mx-auto w-full max-w-[240px] rounded-sm shadow-sm"
          />

          <p class="mt-4 text-xl text-sky-700">
            Tim Bedford, CEO
          </p>

        </div>

        <!-- Copy -->
        <div>

          <p class="text-xl leading-relaxed text-slate-800 md:text-2xl">

            Coming alongside Christian leaders around the world.

            Paraclete Mission Group comes alongside mission agencies,
            churches, and church planting movements serving around
            the world.

            <span class="text-amber-600e
            in life and ministry.

          </p>

          <!-- CTA -->
          <div class="mt-10">

            /about
              About Us
            </a>

          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- NEXT SECTION:
       2025 IMPACT / ANIMATED COUNTERS
  -->

</BaseLayout>