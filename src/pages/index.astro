---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Home";
---

<BaseLayout pageTitle={pageTitle} transparentHeader={true}>

  <!-- HERO -->
  <section class="relative h-[75vh]">
    <img
      src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/largegroup_hero1.jpg"
      alt="Paraclete Mission Group associates"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-black/30"></div>

    <div class="relative z-10 flex h-full items-center">
      <div class="w-full max-w-7xl px-6 pt-12">
        <div class="max-w-3xl md:pl-20">
          <h1 class="text-white text-5xl md:text-6xl font-bold leading-tight">
            <span class="block">
              Coming <span class="text-emerald-500">alongside</span>
            </span>
            <span class="block md:pl-12">
              Christian leaders
            </span>
          </h1>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT INTRO SECTION -->
<section class="bg-stone-50 py-24">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Definition -->
    <div class="mx-auto mb-16 max-w-5xl text-center">
      <p class="font-serif italic text-3xl md:text-5xl text-slate-700 leading-relaxed">
        paráklētos —
      </p>

      <p class="mt-4 font-serif italic text-xl md:text-3xl text-slate-600 leading-relaxed">
        one who consoles or comforts, one who encourages or uplifts;
        hence refreshes, and/or one who intercedes on our behalf as an advocate.
      </p>
    </div>

    <!-- Lead Statement -->
    <div class="mx-auto mb-16 max-w-4xl text-center">
      <h2 class="font-serif text-3xl md:text-4xl text-emerald-800 leading-tight">
        Coming alongside Christian leaders around the world.
      </h2>
    </div>

    <!-- Main Content -->
    <div class="grid gap-12 lg:grid-cols-[360px_1fr] items-start">

      <!-- CEO Card -->
      <aside class="rounded-2xl bg-white p-6 shadow-md">

        <img
          src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/ceo_tim_bedford.jpg"
          alt="Tim Bedford"
          class="w-full rounded-xl object-cover"
        />

        <h3 class="mt-5 text-center text-2xl font-semibold text-slate-800">
          Tim Bedford
        </h3>

        <p class="text-center text-sky-700">
          President & CEO
        </p>

        <div class="mt-6 border-t pt-6">
          <p class="italic text-slate-600 leading-relaxed">
            “Our mission is to come alongside Christian leaders,
            helping them thrive personally and strategically in
            ministry around the world.”
          </p>
        </div>

      </aside>

      <!-- Text Content -->
      <div class="max-w-4xl">

        <p class="text-xl md:text-2xl leading-relaxed text-slate-800">

          Paraclete Mission Group comes alongside mission agencies,
          churches, and church planting movements serving around
          the world.

          <span class="font-semibold text-amber-700">
            Paraclete associates
          </span>

          are experienced missionaries and professionals who use
          their histories, skills, and gifts to partner with
          individuals and organizations to help them become more
          effective in life and ministry.

          <br /><br />

          Whether providing coaching, leadership development,
          organizational consulting, member care, or strategic
          guidance, Paraclete associates draw upon decades of
          cross-cultural ministry experience to strengthen leaders
          and organizations for long-term Kingdom impact.

        </p>

        <!-- CTA -->
        <div class="mt-10 ">
          <a
            href="/contact"
            class="inline-block rounded-full bg-emerald-600 px-8 py-4 text-center font-semibold text-white shadow-lg hover:bg-emerald-700"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>