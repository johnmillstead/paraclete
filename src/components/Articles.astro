---
/**
 * Articles.astro
 * ----------------
 * Homepage "articles/blog teaser" section.
 *
 * Full-width frame color (#dde5eb) is sampled from the "2025 Scope" map
 * band in the concept mockup, so this section reads as a continuation of
 * that band rather than a floating card. Card markup lives in
 * ArticleCard.astro, shared with the /articles listing page.
 *
 * Reads from the `posts` content collection (src/content.config.ts), whose
 * confirmed schema is:
 *
 *   title:  string
 *   date:   Date
 *   image:  string (optional)
 *   author: reference("authors")   // resolved below via getEntry()
 *
 * Notes on fields that AREN'T in the schema (yet):
 * - No `excerpt` field — ArticleCard derives the card excerpt from
 *   `post.rendered.html`. Add an `excerpt` field to config.yml + the posts
 *   schema if you'd rather author excerpts by hand.
 * - No `category` field, so there's no category badge on the card.
 * - No `draft` field on posts yet, so there's no draft filtering here.
 */
import { getCollection, getEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';

interface Props {
  /** Section eyebrow/heading */
  heading?: string;
  /** How many recent posts to show in the teaser grid */
  limit?: number;
  /** Where the "More Posts" button should point */
  viewAllHref?: string;
  /** Base path for individual post pages, e.g. "/articles" -> /articles/my-post-slug/ */
  postBasePath?: string;
}

const {
  heading = 'Missions Updates',
  limit = 4,
  viewAllHref = '/articles',
  postBasePath = '/articles',
} = Astro.props;

const allPosts = await getCollection('posts');

const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, limit);

// `author` is a reference() to the `authors` collection — resolve each one
// so ArticleCard can render the byline/avatar.
const cards = await Promise.all(
  posts.map(async (post) => ({
    post,
    author: await getEntry(post.data.author),
  }))
);
---

{/*
  Frame color (#dde5eb) is sampled directly from the "2025 Scope" map
  section in the concept mockup. `w-full` alone only fills whatever
  container this section sits inside (e.g. BaseLayout's centered <main>),
  which is why it wasn't reaching the viewport edges on the live build.
  The `relative left-1/2 right-1/2 w-screen -mx-[50vw]` combo is the
  standard "full-bleed breakout" trick: it escapes any parent max-width
  regardless of that parent's width or padding, so this always spans the
  true viewport edge-to-edge like the map band above it. Swap the color
  for a design-token class (e.g. bg-paraclete-mist) once one exists in
  tailwind.config.
*/}
<section class="relative left-1/2 right-1/2 w-screen -mx-[50vw] bg-[#dde5eb] py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <h2 class="text-center text-2xl font-bold uppercase tracking-wide text-teal-900 sm:text-3xl">
      {heading}
    </h2>

    {cards.length === 0 ? (
      <p class="mt-8 text-center text-slate-600">More stories are on the way — check back soon.</p>
    ) : (
      <div class="mt-8 grid justify-items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {cards.map(({ post, author }) => (
          <ArticleCard post={post} author={author} postBasePath={postBasePath} />
        ))}
      </div>
    )}

    <div class="mt-10 flex justify-center">
      <a
        href={viewAllHref}
        class="rounded-full border border-teal-800 px-6 py-2 text-sm font-semibold text-teal-800 transition-colors hover:bg-teal-800 hover:text-white"
      >
        More Posts
      </a>
    </div>
  </div>
</section>
