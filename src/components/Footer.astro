---
// Footer.astro
// Paraclete Mission Group — site footer
//
// TODO before shipping:
// 1. Swap the "#" hrefs below for real routes once About Us / Join Paraclete /
//    Donate / Financials / Log In pages exist.
// 2. Wire up the two [data-chat-trigger] elements (the "Contact Us" pill and
//    the round chat-bubble button) to the AI chat agent widget once it's set up.
// 3. Consider self-hosting the ECFA / Missio Nexus logos (currently pulled
//    from their own domains) so the footer doesn't depend on third-party uptime.

interface NavLink {
  label: string;
  href: string;
}

const navLinks: NavLink[] = [
  { label: "About Us", href: "#" },
  { label: "Join Paraclete", href: "#" },
  { label: "Donate", href: "#" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Financials", href: "#" },
];
---

<footer class="bg-[#0a4958] text-white">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <!-- Logo + Contact/Log In -->
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <a href="/" class="inline-flex items-center">
        <img
          src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/hlogo.png"
          alt="Paraclete Mission Group"
          class="h-16 w-auto"
        />
      </a>

      <div class="flex items-center gap-4">
        <button
          type="button"
          data-chat-trigger
          class="rounded-full bg-[#4d878f] px-6 py-2.5 text-sm font-medium text-white transition hover:bg-[#3f747b] sm:text-base"
        >
          Contact Us
        </button>
        <a
          href="#"
          class="rounded-full bg-[#ed975d] px-6 py-2.5 text-sm font-medium text-white transition hover:bg-[#e2854a] sm:text-base"
        >
          Log In
        </a>
      </div>
    </div>

    <!-- Nav links -->
    <nav aria-label="Footer" class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-white/90 transition hover:text-white sm:text-base"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Divider + chat bubble -->
    <div class="mt-10 flex items-center gap-6">
      <div class="h-px flex-1 bg-white/30"></div>
      <button
        type="button"
        data-chat-trigger
        aria-label="Chat with us"
        class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white text-[#0a4958] shadow transition hover:bg-white/90"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
          <path d="M12 2C6.48 2 2 5.94 2 10.8c0 2.77 1.45 5.24 3.72 6.86-.12.9-.47 2.4-1.44 3.86 0 0 2.4-.24 4.98-2.05.87.2 1.79.31 2.74.31 5.52 0 10-3.94 10-8.8C22 5.94 17.52 2 12 2z"/>
        </svg>
      </button>
    </div>

    <!-- Trust badges + social -->
    <div class="mt-10 flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-center gap-8">
        <img
          src="https://www.ecfa.org/Images/Header/ECFA_logo_2color.svg"
          alt="ECFA Accredited Member"
          class="h-20 w-auto"
        />
        <img
          src="https://pub-6dab674ceebc49aba7c626445056fa38.r2.dev/images/charitynav4star.png"
          alt="Charity Navigator Four-Star Rating, 2025"
          class="h-24 w-auto"
        />
        <img
          src="https://missionexus.org/wp-content/uploads/2022/05/MNEX-Horizontal-RGB-%C2%AE.png"
          alt="Missio Nexus"
          class="h-8 w-auto brightness-0 invert"
        />
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://www.instagram.com/paracletemissiongroup"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Paraclete Mission Group on Instagram"
          class="block h-8 w-8 transition hover:opacity-80"
        >
          <svg viewBox="0 0 32 32" class="h-8 w-8">
            <defs>
              <linearGradient id="pmg-ig-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#FFDD55"/>
                <stop offset="50%" stop-color="#E1306C"/>
                <stop offset="100%" stop-color="#5851DB"/>
              </linearGradient>
            </defs>
            <circle cx="16" cy="16" r="16" fill="url(#pmg-ig-gradient)"/>
            <rect x="10" y="10" width="12" height="12" rx="4" fill="none" stroke="white" stroke-width="1.6"/>
            <circle cx="16" cy="16" r="3.4" fill="none" stroke="white" stroke-width="1.6"/>
            <circle cx="20.2" cy="11.8" r="0.9" fill="white"/>
          </svg>
        </a>

        <a
          href="https://www.facebook.com/paracletemissiongroup"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Paraclete Mission Group on Facebook"
          class="block h-8 w-8 transition hover:opacity-80"
        >
          <svg viewBox="0 0 32 32" class="h-8 w-8">
            <circle cx="16" cy="16" r="16" fill="#1877F2"/>
            <path
              d="M18.14 11.5h1.86V8.6h-2.2c-2.35 0-3.6 1.4-3.6 3.68v1.62h-2v2.9h2V23.4h3V16.8h2.1l.35-2.9h-2.45v-1.3c0-.72.2-1.1 1.24-1.1z"
              fill="white"
            />
          </svg>
        </a>

        <a
          href="https://www.linkedin.com/company/paraclete-mission-group/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Paraclete Mission Group on LinkedIn"
          class="block h-8 w-8 transition hover:opacity-80"
        >
          <svg viewBox="0 0 32 32" class="h-8 w-8">
            <rect x="0" y="0" width="32" height="32" rx="6" fill="#0A66C2"/>
            <path
              d="M9 13h3v10H9zM10.5 11.3a1.7 1.7 0 110-3.4 1.7 1.7 0 010 3.4zM14.5 13h2.9v1.4h.04c.4-.75 1.4-1.55 2.9-1.55 3.1 0 3.66 2 3.66 4.6V23h-3v-4.7c0-1.1 0-2.55-1.55-2.55-1.55 0-1.8 1.2-1.8 2.46V23h-3z"
              fill="white"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Placeholder hook for the AI chat agent — not wired up yet.
  // Replace this with the real widget's open/toggle call once it's available.
  document.querySelectorAll("[data-chat-trigger]").forEach((el) => {
    el.addEventListener("click", () => {
      console.info("Chat agent isn't configured yet — hook it up in Footer.astro.");
    });
  });
</script>
