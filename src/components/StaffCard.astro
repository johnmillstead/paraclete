---
interface Props {
  name: string;
  title: string;
  photo?: string;
  slug: string;
 }

const { name, title, photo, slug } = Astro.props;

function getInitials(name: string) {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<div class="staff-card">
  <div class="photo-wrap">
    {photo ? (
      <img src={photo} alt={`Photo of ${name}`} />
    ) : (
      <div class="initials">{getInitials(name)}</div>
    )}
  </div>
  <p class="staff-name">{name}</p>
  <p class="staff-title">{title}</p>

</div>

<style>
  .staff-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .photo-wrap {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #e5e7eb;
    background: #f9fafb;
    flex-shrink: 0;
  }

  .photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 400;
    color: #9ca3af;
  }

  .staff-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text, #111827);
    margin: 0;
    line-height: 1.3;
  }

  .staff-title {
    font-size: 0.825rem;
    font-style: italic;
    font-weight: 400;
    color: var(--color-text-muted, #6b7280);
    margin: 0;
    line-height: 1.4;
  }


</style>