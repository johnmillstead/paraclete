---
import BaseLayout from "./BaseLayout.astro";
---
<BaseLayout pageTitle="Ministry" transparentHeader={true}>
<div class="container mx-auto p-4">
    <main class="flex flex-col justify-center items-center lg:flex-row lg:justify-between lg items-start">
        <div class="lg:w-2/3 px-4">
        <!-- Main content area takes up the left 2/3 of the page -->
        <slot />
        </div>
        <div class="lg:w-1/3 xl:w-1/3 py-4">
        <!-- Right sidebar or section goes here -->
        <section class="resource-section">
            <!-- Resource content goes here -->
        </section>
        </div>
    </main>
</div>
</BaseLayout>